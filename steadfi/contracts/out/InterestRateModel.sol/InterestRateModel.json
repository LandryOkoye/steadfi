"_slope1PerYear\":\"Annual slope 1 in Ray.\",\"_slope2PerYear\":\"Annual slope 2 in Ray.\"}},\"getBorrowRatePerSecond(uint256,uint256)\":{\"params\":{\"totalDebtRay\":\"Total outstanding debt in Ray.\",\"totalSupplyRay\":\"Total supplied liquidity in Ray.\"}},\"getSupplyRatePerSecond(uint256,uint256,uint256)\":{\"params\":{\"reserveFactor\":\"Reserve factor in 1e4 precision (e.g. 1000 = 10%).\",\"totalDebtRay\":\"Total outstanding debt in Ray.\",\"totalSupplyRay\":\"Total supplied liquidity in Ray.\"}}},\"stateVariables\":{\"PCT_PRECISION\":{\"details\":\"Reserve factor precision: 1e4 = 100.00%\"}},\"title\":\"InterestRateModel\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"baseRatePerYear()\":{\"notice\":\"Base borrow rate per year in Ray (e.g. 0 for 0%).\"},\"getBorrowRatePerSecond(uint256,uint256)\":{\"notice\":\"Returns the per-second borrow rate in Ray (1e27).\"},\"getBorrowRatePerYear(uint256)\":{\"notice\":\"Annual borrow rate at a given utilization (for UI display).\"},\"getSupplyRatePerSecond(uint256,uint256,uint256)\":{\"notice\":\"Returns the per-second supply rate in Ray.\"},\"getUtilization(uint256,uint256)\":{\"notice\":\"Current utilization ratio in Ray (totalDebt / totalSupply).\"},\"kink()\":{\"notice\":\"Kink utilization in Ray (e.g. 0.9e27 for 90%).\"},\"slope1PerYear()\":{\"notice\":\"Slope 1 \\u2014 rate added per unit utilization up to kink, per year in Ray.\"},\"slope2PerYear()\":{\"notice\":\"Slope 2 \\u2014 rate above kink, per year in Ray.\"}},\"notice\":\"Two-slope (kinked) interest rate model.         Below the kink:           borrowRate = baseRate + utilization * slope1 / kink         Above the kink:           borrowRate = baseRate + slope1 + (utilization - kink) * slope2 / (RAY - kink)         supplyRate = borrowRate * utilization * (1 - reserveFactor)         All rates are ANNUAL in Ray (1e27). The LendingPool converts to per-second         before compounding: ratePerSecond = annualRate / SECONDS_PER_YEAR.         Arc note: gas is USDC so keepers can call accrueInterest() cheaply.         We use per-second compounding (not per-block) because Arc has sub-second         finality and no reorgs \\u2014 timestamps are reliable.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/InterestRateModel.sol\":\"InterestRateModel\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/=lib/openzeppelin-contracts/\",\":forge-std/=lib/forge-std/src/\"],\"viaIR\":true},\"sources\":{\"src/InterestRateModel.sol\":{\"keccak256\":\"0x4de3387b3adb4431ea016b715ac40a941b0a2dc989f30fda1976cb86b19dbdf5\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://d513806ec2388de019841ab325fce48584fa7de256a6cd2296791be0f5b27225\",\"dweb:/ipfs/QmZFFgtoAkkh5oZqtPn3KunJhN2ehRTQCcjZ45yrXWiBye\"]},\"src/interfaces/IInterestRateModel.sol\":{\"keccak256\":\"0xf2b48f923db78235d6e17cfd7d978c0317311183903f62facd699f61e787e8cb\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://98ab9ccb46e493cf0ba747ae786b94896893d0cd2f7f06210bb97d102e151e68\",\"dweb:/ipfs/QmXttSLbPL7GMCNEsdMs2pNyjhQ6rtsNUuCzjMF7BEYnUC\"]},\"src/libraries/RayMath.sol\":{\"keccak256\":\"0x739d2b65e223c240909f5631be09b07f027e5851a615ac332f2a548648dbae77\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://b431f0c4f393707907a9fc515e90c9595ddece5aa73440aed2c0a77a65c2399f\",\"dweb:/ipfs/QmbPdFVPn74CSGUpxBLaSSyqoKTpwNhmFHabAbwcQQs8T8\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256","name":"_baseRatePerYear","type":"uint256"},{"internalType":"uint256","name":"_slope1PerYear","type":"uint256"},{"internalType":"uint256","name":"_slope2PerYear","type":"uint256"},{"internalType":"uint256","name":"_kink","type":"uint256"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[{"internalType":"uint256","name":"baseRatePerYear","type":"uint256","indexed":false},{"in